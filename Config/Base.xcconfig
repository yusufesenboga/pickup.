// Change BUNDLE_PREFIX to your reverse-DNS identifier before registering capabilities.
BUNDLE_PREFIX = com.yusufesenboga
PICKUP_APP_GROUP = group.$(BUNDLE_PREFIX).pickup
// Set your team locally in Xcode or pass DEVELOPMENT_TEAM on the command line.
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
SWIFT_EMIT_LOC_STRINGS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
CLANG_ENABLE_MODULES = YES
// Embedded extensions are already signed; preserve their binaries during copy.
COPY_PHASE_STRIP = NO
